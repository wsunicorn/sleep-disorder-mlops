# Biến môi trường — copy file này thành .env và điền giá trị thực

# Django
DJANGO_SECRET_KEY=change-me-in-production-use-secrets-manager
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DRF_ANON_THROTTLE_RATE=5000/day
DRF_USER_THROTTLE_RATE=10000/day

# Database (AWS RDS PostgreSQL)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/sleep_portal

# Redis (AWS ElastiCache)
REDIS_URL=redis://localhost:6379/0

# AWS
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=ap-southeast-1
S3_BUCKET=sleep-mlops-651709
ECR_REGISTRY=651709558967.dkr.ecr.ap-southeast-1.amazonaws.com
ECR_REPOSITORY=sleep-portal

# MLflow production (ECS service qua ALB port 5000)
MLFLOW_TRACKING_URI=http://sleep-portal-alb-67325866.ap-southeast-1.elb.amazonaws.com:5000
MLFLOW_MODEL_NAME=sleep-disorder-classifier
MLFLOW_MODEL_STAGE=Production
MLFLOW_ARTIFACTS_DESTINATION=s3://sleep-mlops-651709/mlflow-artifacts
MODEL_PROMOTE_STAGE=Production
MODEL_PROMOTE_THRESHOLD=0.55
MODEL_REQUIRE_PROMOTION=true

# Model artifacts và feature store cho vòng lặp MLOps
MODEL_ARTIFACT_S3_URI=s3://sleep-mlops-651709/models
MODEL_ARTIFACT_LOCAL_DIR=models
MLOPS_FEATURE_STORE_S3_URI=s3://sleep-mlops-651709/monitoring/current
MLOPS_FEATURE_STORE_LOCAL_DIR=data/monitoring/current
RETRAIN_TRAINING_DATA=s3://sleep-mlops-651709/features/reference/features.parquet
DRIFT_REFERENCE_DATA=s3://sleep-mlops-651709/features/reference/features.parquet
DRIFT_CURRENT_DATA=s3://sleep-mlops-651709/monitoring/current
EDF_SYNC_MAX_EPOCHS=96

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=sleep/sensor
