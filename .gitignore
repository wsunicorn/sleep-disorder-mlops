# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.env
*.egg-info/
dist/
build/

# DVC — data files không commit lên Git
data/raw/*
data/processed/*
data/features/*
data/monitoring/*
!data/raw/.gitkeep
!data/raw/*.dvc
!data/processed/.gitkeep
!data/features/.gitkeep
!data/monitoring/.gitkeep
!.dvc/config
!.dvc

# MLflow — tracked locally, too large for Git
mlruns/
mlartifacts/

# Test / coverage artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Model binaries — large binary files, use DVC or download separately
models/*.pkl
models/*.ubj
models/*.bin

# Django
sleep_portal/staticfiles/
sleep_portal/media/
*.log
local_settings.py
db.sqlite3

# Docker
.dockerignore

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Generated report/export artifacts
docs/generated/
docs/*_finish.docx
docs/*_finish.md
docs/*_finish_media/
~$*.docx

# Secrets
.env
*.pem
*.key
